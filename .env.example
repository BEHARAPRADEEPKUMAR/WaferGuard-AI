DATABRICKS_HOST=https://<your-workspace-host>
DATABRICKS_TOKEN=<create-a-new-token-and-keep-it-private>
DATABRICKS_ENDPOINT=waferguard-defect-detection
WAFERGUARD_BATCH_SIZE=25
DATABRICKS_CONNECT_TIMEOUT=15
DATABRICKS_READ_TIMEOUT=120
DATABRICKS_MAX_RETRIES=3
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
